<?xml version="1.0"?>
<psalm
    xmlns="https://getpsalm.org/schema/config"
    errorBaseline="psalm-baseline.xml"
    resolveFromConfigFile="true"
>
    <projectFiles>
        <directory name="app"/>
        <directory name="tests"/>
        <ignoreFiles>
            <directory name="vendor"/>
            <directory name="bootstrap/cache"/>
            <directory name="storage/framework"/>
            <directory name="database/migrations"/>
            <directory name="database/factories"/>
            <directory name="database/seeders"/>
            <file name="routes/console.php"/>
        </ignoreFiles>
    </projectFiles>
    <fileExtensions>
        <extension name="php"/>
    </fileExtensions>
    <plugins>
        <plugin class="Psalm\LaravelPlugin\Plugin" filename="vendor/psalm/plugin-laravel/src/Plugin.php"/>
    </plugins>
</psalm>
